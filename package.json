    "build:web": "npm run build --workspace @krx/web",
    "build:api": "npm run build --workspace @krx/api",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "overrides": {
    "postcss": "8.5.15",
    "next@15.5.19": {
      "postcss": "8.5.15"
    }
  }
